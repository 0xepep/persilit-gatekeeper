# Copy to .env (local only — NEVER commit .env, never paste the real secret here in chat)
# The value comes from the Agent Games dashboard: register agent -> Rotate Secret.
PORT=3000
AGENT_GAMES_HMAC_SECRET=
SEEN_FILE=./data/seen.json
# Local dev only. NEVER true on the registered public endpoint.
ALLOW_UNSIGNED_TASKS=false
# v2: true in production — local Groth16 proofs via snarkjs (see proof.js).
# Keep false only to run decision-only (v1 behaviour).
PROOF_ENABLED=true
